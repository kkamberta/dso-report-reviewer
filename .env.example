# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── Standard Anthropic API ────────────────────────────────────────────────────
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Company gateway (MFEC) — set both to use the company token ────────────────
# Get a key from https://llm-request.mfec.dev
# ANTHROPIC_API_KEY=<your_mfec_api_key>
# REVIEWER_BASE_URL=https://claude-to-openai-adapter.sasis.site/

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
REVIEWER_MODEL=claude-sonnet-4-6
REVIEWER_CHUNK_SIZE=50
REVIEWER_MAX_RETRIES=1
